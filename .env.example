# ==========================================
# ECOMMERCE VENTAS - ENVIRONMENT CONFIGURATION
# ==========================================

# Server & Runtime
PORT=4000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ecommerce_ventas

# Authentication & Security
JWT_ACCESS_SECRET=nexus_super_access_secret_key_7634xyz
JWT_REFRESH_HMAC_SECRET=nexus_refresh_hmac_secret_key_9988_abc

# OAuth 2.1 & Model Context Protocol (MCP)
JWT_SECRET_OAUTH=nexus_super_secret_jwt_key_2798

# External Services (OpenAPI Suite)
OPENAPI_API_KEY=test_openapi_sandbox_key

# Service URLs
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3001

# CORS & Host Whitelisting (CSV separated)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Frontend Build Arguments (optional, leave empty for Nginx proxy routing)
NEXT_PUBLIC_API_URL=
